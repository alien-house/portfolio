# このファイルを `youtube_summary/.env` にコピーして値を書く（git には載せない）。
# （Vercel の場合は Project の環境変数 + Next.js Route Handler `app/api/portfolio/youtube-dify-summary` を使う）

# Existing Gemini-powered route
GEMINI_API_KEY=

# Dify workflow proxy (portfolio experiment — keys stay server-side only)
DIFY_API_KEY=
# Full POST target, e.g. https://your-dify-host/v1/workflows/run
DIFY_WORKFLOW_URL=
# Dify アプリ側の入力変数名（既定: youtube_url）
DIFY_INPUT_FIELD=youtube_url
# Which key holds the rendered summary under response JSON data.outputs.*
DIFY_OUTPUT_FIELD=text

# Comma-separated list; set your real portfolio origin(s) in production
ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:5500
